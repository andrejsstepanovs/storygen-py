LLM_API_KEY=your_llm_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
LLM_BASE_URL=https://opencode.ai/zen/go/v1
MODEL_NAME=deepseek-v4-flash

# ─── LLM Provider Examples ───────────────────────────────────────────────────
# Uncomment and fill in the section for the provider you want to use.
# Only ONE provider should be active at a time.
# Comments show the format for OpenAI-compatible endpoints.
# For Anthropic models you need a proxy (e.g. OpenRouter, Portkey) that
# translates OpenAI API calls into Anthropic's format.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (official) ──────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# MODEL_NAME=gpt-4o-mini

# ── OpenRouter (supports OpenAI + Anthropic + Gemini + many others) ───────
# Sign up at https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# MODEL_NAME=anthropic/claude-sonnet-4-20250514
# MODEL_NAME=openai/gpt-4o-mini
# MODEL_NAME=google/gemini-2.0-flash-exp

# ── OpenCode Zen (current default) ────────────────────────────────────────
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=sk-...
# MODEL_NAME=deepseek-v4-flash